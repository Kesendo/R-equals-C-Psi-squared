#!/bin/sh
# Warn (non-blocking) about four things in staged files:
#  1. links to a gitignored local-only WIP script simulations/_*.py
#  2. an em dash (U+2014) in a repo doc (forbidden + a "quality round never done" tell)
#  3. a broken Markdown table in a repo doc (won't render + the same tell, orthogonal)
#  4. substantial claim-surface staged -> remind of the empty-session round
#     (becoming-your-own-outside; the trigger lives in the structure, not in
#     the writer's judgment, because the writer's cut cannot see itself)
#  5. staged prose spending a word the repo already spends (Clock, Field, Mirror,
#     memory, light ...). Same reason as 4, one layer down: the coiner cannot feel
#     a collision, because from the native stance the word fits. Ordinary-looking
#     words only; the term-shaped ones get looked up unprompted anyway.
#  6. a staged arc doc cited by files it never cites back (the missing BACK-EDGE,
#     the 2026-08-04 m=0-hunt structural find: openers edited after their
#     successors landed still list as open what the successors closed; ~300
#     one-directional pairs at the sweep. Same reason as 4, one layer out: the
#     opener cannot feel its successors).
# Enable once with:  git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)" || exit 0
if command -v python >/dev/null 2>&1; then PY=python
elif command -v python3 >/dev/null 2>&1; then PY=python3
else exit 0; fi
"$PY" "$root/.githooks/check_wip_refs.py"
"$PY" "$root/.githooks/check_em_dashes.py"
"$PY" "$root/.githooks/check_broken_tables.py"
"$PY" "$root/.githooks/check_empty_round.py"
"$PY" "$root/.githooks/check_spent_words.py"
"$PY" "$root/.githooks/check_back_edges.py"
"$PY" "$root/.githooks/check_coupling.py"
exit 0
